# Copy to .env (docker compose reads it) or export before `npm start`.
# Production defaults are baked in; override for staging.

STATION_ID=655347b59c00a7409d9181c3
SOCKET_URL=https://backend.hgdjlive.com
PANEL_URL=https://hgdjlive.com
ICECAST_URL=https://icecast.hgdjlive.com
WEBSITE_URL=https://hgcradio.org

# Strongly recommended: lets the probe join as "synthetic-listener-*" with
# canPublish=false and read server-side room truth. Same values as the panel's
# LIVEKIT_* in /root/audio_stream/.env.local (rotate them first, see
# ops/incident-review/compromise-containment.md).
LIVEKIT_URL=wss://webrtc.hgdjlive.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Backend ops endpoints (after ops/backend-patches is deployed)
BACKEND_OPS_TOKEN=

PROBE_ID=synthetic-listener-fra1
TICK_SECONDS=60
STATE_CHANGE_DEADLINE_SECONDS=10
AUDIO_SILENCE_DBFS=-50
ICECAST_SAMPLE_SECONDS=4
METADATA_STALE_GRACE_SECONDS=180
SCHEDULED_NO_DJ_MINUTES=5
# Optional: enables Icecast silence detection. In the Docker image this is /usr/bin/ffmpeg.
FFMPEG_PATH=/usr/bin/ffmpeg
METRICS_PORT=9101
LOG_DIR=/data/logs

# Alerts: configure at least one. Telegram is the fastest to set up
# (@BotFather -> token; message the bot; chat id from getUpdates).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_DISCORD_WEBHOOK=
ALERT_SLACK_WEBHOOK=
ALERT_WEBHOOK_URL=
# Uptime Kuma "Push" monitor URL (create the monitor first, paste its push URL).
UPTIME_KUMA_PUSH_URL=
ALERT_REMIND_MINUTES=15

# Grafana admin password for the bundled stack
GRAFANA_ADMIN_PASSWORD=change-me
